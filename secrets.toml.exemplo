# ------------------------------------------------------------------
# COMO USAR ESTE ARQUIVO:
# 1) Renomeie este arquivo para "secrets.toml" (remova o ".exemplo")
# 2) Preencha com os dados do SEU projeto Supabase (ver guia de deploy)
# 3) NUNCA suba o arquivo "secrets.toml" (com os dados reais) para o GitHub.
#    Ele já está listado no .gitignore para sua proteção.
#
# Em produção (Streamlit Community Cloud), você NÃO usa este arquivo:
# em vez disso, cola o mesmo conteúdo dentro de
# "App settings" -> "Secrets" no painel do Streamlit Cloud.
# ------------------------------------------------------------------

SUPABASE_URL = "https://SEU-PROJETO.supabase.co"
SUPABASE_SERVICE_KEY = "SUA-CHAVE-SERVICE-ROLE-AQUI"
