{
  "name": "cursos-telecom-desktop",
  "version": "1.0.0",
  "description": "Plataforma de Treinamentos em Telecomunicações — app de desktop (casca do site publicado no Streamlit Cloud)",
  "main": "main.js",
  "author": "Norte Tel",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dist:win": "electron-builder --win --x64",
    "dist:linux": "electron-builder --linux --x64"
  },
  "devDependencies": {
    "electron": "^31.3.0",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.nortetel.cursostelecom",
    "productName": "Treinamentos Telecom",
    "directories": {
      "output": "release"
    },
    "files": [
      "main.js",
      "preload.js",
      "package.json"
    ],
    "win": {
      "target": [
        { "target": "nsis", "arch": ["x64"] },
        { "target": "portable", "arch": ["x64"] }
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "linux": {
      "target": ["AppImage"],
      "icon": "build/icon.png",
      "category": "Education"
    }
  }
}
