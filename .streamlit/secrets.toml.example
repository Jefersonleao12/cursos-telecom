# ------------------------------------------------------------------
# COMO USAR ESTE ARQUIVO (só para rodar o projeto NA SUA MÁQUINA):
# 1) Copie este arquivo para "secrets.toml" (mesma pasta, sem o ".example")
# 2) Preencha o "secrets.toml" com os dados do SEU projeto Supabase
# 3) O "secrets.toml" (com os dados reais) nunca deve ser commitado — ele
#    já está no .gitignore. Só ESTE arquivo (.example, com valores de
#    mentira) fica versionado, de propósito, como referência.
#
# Em produção (Streamlit Community Cloud OU Render), você NÃO usa nenhum
# arquivo secrets.toml: configura as mesmas chaves como "Secrets"
# (Streamlit Cloud) ou "Environment Variables" (Render) no painel de cada
# um. Ver seção "Hospedagem" no README para o passo a passo de cada host.
# ------------------------------------------------------------------

SUPABASE_URL = "https://SEU-PROJETO.supabase.co"
SUPABASE_SERVICE_KEY = "SUA-CHAVE-SERVICE-ROLE-AQUI"

# ------------------------------------------------------------------
# OPCIONAL: notificação automática no WhatsApp (via CallMeBot, gratuito)
# sempre que um aluno envia uma dúvida ou pede redefinição de senha.
# Sem essas duas chaves, a plataforma funciona normalmente — só não avisa
# no WhatsApp (a dúvida continua salva e visível no painel de admin).
#
# Como conseguir:
# 1) Salve o número +34 644 84 71 15 nos seus contatos do WhatsApp.
# 2) Envie a mensagem "I allow callmebot to send me messages" para esse
#    número (em inglês, exatamente assim).
# 3) O CallMeBot responde com sua apikey pessoal.
# 4) Preencha abaixo: WHATSAPP_PHONE é o SEU número (com DDI, ex: 5569999999999)
#    e WHATSAPP_APIKEY é o código recebido.
# 5) Depois de preencher/testar, use o botão "Testar notificação por
#    WhatsApp" no painel de admin (aba Dúvidas) para confirmar.
# ------------------------------------------------------------------
WHATSAPP_PHONE = "5569999999999"
WHATSAPP_APIKEY = "SUA-APIKEY-DO-CALLMEBOT-AQUI"
